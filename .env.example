# Base URL of the Accewa NestJS API, WITHOUT the /api/v1 suffix (added by the SDK).
NEXT_PUBLIC_API_URL=https://accewa-g5xf.onrender.com

# Public Razorpay key used to open the Razorpay Checkout widget client-side.
# Must match RAZORPAY_KEY_ID configured on the backend.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
